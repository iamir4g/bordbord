HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=strapi
DATABASE_SSL=false

# API token from Strapi Admin → Settings → API Tokens (Full access)
STRAPI_TOKEN=
STRAPI_URL=http://localhost:1337

# OTP auth
OTP_SMS_PROVIDER=mock
OTP_DEBUG_EXPOSE_CODE=true
OTP_HASH_SECRET=replace-with-a-long-random-secret
OTP_EXPIRES_SECONDS=120
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5

# ippanel SMS provider (set OTP_SMS_PROVIDER=ippanel to enable)
IPPANEL_API_TOKEN=your-ippanel-api-token
IPPANEL_PATTERN_CODE=your-pattern-code
IPPANEL_FROM_NUMBER=+983000505
IPPANEL_PATTERN_VARIABLE=code
